{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "bun",
      "node"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "index.ts",
    "tests/**/*.ts"
  ]
}
